rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Multi-image posts: posts/{uid}/{postId}/{index}.jpg (index 0-2).
    // Any signed-in user may view; only the owner may upload — JPEG only,
    // strictly under 1 MB (the client compresses to guarantee this) — or
    // delete their own files (needed to roll back a failed post).
    match /posts/{userId}/{postId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 1 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Legacy single-image posts (post_images/{uid}/{timestamp}.jpg): kept
    // readable so existing posts still render; no new uploads land here.
    match /post_images/{userId}/{fileName} {
      allow read: if request.auth != null;
    }

    // Stories: stories/{uid}/{storyId}.jpg — same contract as posts (JPEG,
    // strictly under 1 MB, client-compressed). Owner uploads/deletes; any
    // signed-in user may view.
    match /stories/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 1 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // DM images: dm_images/{cid}/{fileName}.jpg. The cid is the two
    // participant uids sorted and joined with '_', so splitting on '_'
    // yields the participant list — only they may read or upload. Relies on
    // Firebase-generated uids never containing '_' (true for auth-created
    // accounts; custom-token uids with underscores would break the check).
    // Immutable once written: no overwrites, no client deletes. NOTE:
    // in Storage rules an overwrite of an existing object evaluates as
    // CREATE (a new generation), not update — proven in the emulator —
    // so immutability requires `resource == null` on create; update:false
    // alone only covers metadata changes.
    // NOT DEPLOYED — storage rules were last released 2026-07-13; this
    // block needs its own storage deploy before DMs ship.
    match /dm_images/{cid}/{fileName} {
      allow read: if request.auth != null
        && cid.split('_').hasAny([request.auth.uid]);
      allow create: if request.auth != null
        && resource == null
        && cid.split('_').hasAny([request.auth.uid])
        && request.resource.size < 1 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg');
      allow update: if false;
      allow delete: if false;
    }

    // Ani Videos: {videoId}.mp4 + {videoId}.jpg thumbnail per upload. Any
    // signed-in user may view; only the owner may upload (videos ≤ 50 MB,
    // thumbnails ≤ 2 MB) or delete their own files.
    match /ani_videos/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && ((request.resource.contentType.matches('video/.*')
              && request.resource.size < 50 * 1024 * 1024)
          || (request.resource.contentType.matches('image/.*')
              && request.resource.size < 2 * 1024 * 1024));
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
